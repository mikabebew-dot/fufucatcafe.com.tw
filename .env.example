# 複製本檔為 .env.local 後填入（.env.local 不可上傳到 Git）
# 在 https://www.sanity.io/manage 建立專案後取得

# ── 公開設定（會出現在瀏覽器，僅為專案識別碼，不是密碼）──
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-07-01

# 官網網址（分享圖片、canonical 會用到；本機開發用 http://localhost:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 機密設定（只在伺服器使用，絕對不可加 NEXT_PUBLIC_ 前綴）──
# 「Viewer」權限 token：只用來在「預覽模式」讀取草稿，無法修改任何資料
SANITY_API_READ_TOKEN=

# 「Editor」權限 token：只給驗收腳本 / 初始化腳本使用。
# 驗收完成後建議到 sanity.io/manage 刪除此 token，平常不需要。
SANITY_API_WRITE_TOKEN=
